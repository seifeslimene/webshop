BASE_URL=http://localhost:3000
MONGODB_URL=mongodb://localhost:27017/webshop

# Generate with: openssl rand -hex 32
NEXT_PUBLIC_ACCESS_TOKEN_SECRET=<your token secret>

# From "aliyun ossutil ls" -> Region column (example: oss-eu-central-1)
NEXT_PUBLIC_ALI_REGION=<your ali region endpoint>
# From "aliyun ossutil ls" -> BucketName (without "oss://")
NEXT_PUBLIC_ALI_BUCKET_NAME=<your ali bucket name>
# RAM Console -> Users -> AccessKey
NEXT_PUBLIC_ALI_ACCESS_KEY=<your ali access key id>
# RAM Console -> Users -> AccessKey (shown once on create)
NEXT_PUBLIC_ALI_SECRET_KEY=<your ali access key secret>
# From "aliyun sts GetCallerIdentity --output json" -> last segment of Arn
NEXT_PUBLIC_ALI_ACS_RAM_NAME=<your ram user or role name>
# Optional object key prefix (example: uploads) - can be left empty
NEXT_PUBLIC_ALI_FILES_PATH=